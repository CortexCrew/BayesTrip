# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed.

# Geoapify Geocoding API key (free tier at https://www.geoapify.com/)
# Used by data_generation/step02_coordinates.py.
# NOTE: variable name is GE0APIFY (zero, not the letter O) -- exact spelling matters.
GE0APIFY_API_KEY=your_geoapify_api_key_here

# OpenTripMap API key (free tier at https://opentripmap.io/product)
# Used by data_generation/step03_bn_prior.py. Still pending.
OPENTRIPMAP_API_KEY=your_opentripmap_api_key_here
